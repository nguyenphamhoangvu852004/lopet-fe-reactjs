VITE_BACKEND_API=http://localhost:8080
# Realtime (STOMP over WebSocket) dùng chung cổng với REST: mặc định suy ra từ
# VITE_BACKEND_API thành ws://localhost:8080/ws. Chỉ đặt biến dưới đây khi reverse
# proxy để endpoint /ws ở một host khác.
#VITE_WS_URL=ws://localhost:8080/ws

# Refresh token đi bằng cookie HttpOnly, nên request phải mang credentials và
# backend phải cho phép credentials. Trên backend đặt:
#   DOMAIN_CORS=http://localhost:5173   (KHÔNG để `*` — `*` tắt allowCredentials)
# Chạy https thật thì backend cũng cần REFRESH_COOKIE_SECURE=true và
# REFRESH_COOKIE_SAME_SITE=None nếu FE khác domain với API.
